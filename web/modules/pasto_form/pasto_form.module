<?php

/**
 * @file
 * Primary module hooks for Pasto form module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_alter().
 */
function pasto_form_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
) {

  if ($form_id == 'node_giornata_form') {
    $form['#attached']['library'][] = 'pasto_form/pasto-details';

    $pasti_fields = [
      'field_colazione',
      'field_pranzo',
      'field_spuntino',
      'field_merenda',
      'field_extra',
      'field_cena',
    ];

    foreach ($pasti_fields as $fname) {
      if (!empty($form[$fname]) && !empty($form[$fname]['widget']) && is_array($form[$fname]['widget'])) {
        render_pasti_in_radio($form[$fname]['widget'], $fname);
        if (!empty($form[$fname]['widget']['#pasto_details']) && is_array($form[$fname]['widget']['#pasto_details'])) {
          $all = implode('', $form[$fname]['widget']['#pasto_details']);
          $form[$fname]['pasti_details'] = [
            '#type' => 'markup',
            '#markup' => \Drupal\Core\Render\Markup::create($all),
            '#weight' => 100,
          ];
        }
      }
    }
  }
}

/**
 * Sostituisce il label dei radio con il rendering del nodo Pasto.
 */
function render_pasti_in_radio(array &$widget, $field_name = NULL)
{
  $entity_type_manager = \Drupal::entityTypeManager();
  $view_builder = $entity_type_manager->getViewBuilder('node');

  if (!empty($widget['#options']) && is_array($widget['#options'])) {
    foreach ($widget['#options'] as $value => $label) {
      if (!is_numeric($value)) {
        continue;
      }

      $pasto = \Drupal::entityTypeManager()->getStorage('node')->load($value);
      if (!$pasto instanceof NodeInterface) {
        continue;
      }

      $safe_title = htmlspecialchars($pasto->label(), ENT_QUOTES, 'UTF-8');
      $widget['#options'][$value] = $safe_title;

      $nid = $pasto->id();
      
      // Estrai i valori del pasto
      $kcal = $pasto->get('field_kcal_pasto')->value ?? 0;
      $carboidrati = $pasto->get('field_carboidrati_pasto')->value ?? 0;
      $grassi = $pasto->get('field_grassi_pasto')->value ?? 0;
      $proteine = $pasto->get('field_proteine_pasto')->value ?? 0;
      $perc_carb = $pasto->get('field_percentuale_carboidrati')->value ?? 0;
      $perc_grassi = $pasto->get('field_percentuale_grassi')->value ?? 0;
      $perc_prot = $pasto->get('field_percentuale_proteine')->value ?? 0;
      
      // Estrai gli obiettivi dell'utente loggato
      $current_user = \Drupal::currentUser();
      $user = \Drupal\user\Entity\User::load($current_user->id());
      $target_kcal_giornaliere = $user->get('field_kcal_giornaliere')->value ?? 0;
      $target_carb = $user->get('field_percentuale_carboidrati')->value ?? 0; 
      $target_grassi = $user->get('field_percentuale_grassi')->value ?? 0; 
      $target_proteine = $user->get('field_percentuale_proteine')->value ?? 0; 
      
      $componenti_html = '';
      $componenti_field = $pasto->get('field_componente_pasto')->getValue();
      if (!empty($componenti_field)) {
        $componenti_html .= '<div class="pasto-componenti"><h4>Componenti:</h4><ul>';
        foreach ($componenti_field as $componente_ref) {
          if (!empty($componente_ref['target_id'])) {
            $componente = \Drupal::entityTypeManager()->getStorage('paragraph')->load($componente_ref['target_id']);
            if ($componente) {
              $tipo_ingrediente = $componente->get('type')->target_id ?? null;
              
              if ($tipo_ingrediente === 'ingrediente_per_100_grammi') {
                $alimento_ref = $componente->get('field_alimento')->first();
                $quantita_grammi = $componente->get('field_quantita_in_grammi')->value ?? 0;
                
                if ($alimento_ref) {
                  $alimento = $alimento_ref->entity;
                  if ($alimento) {
                    $alimento_nome = $alimento->label();
                    $componenti_html .= '<li>' . htmlspecialchars($alimento_nome, ENT_QUOTES, 'UTF-8') . ' - ' . $quantita_grammi . 'g</li>';
                  }
                }
              } elseif ($tipo_ingrediente === 'ingrediente_per_porzione') {
                $alimento_ref = $componente->get('field_alimento_per_porzione')->first();
                $numero_porzioni = $componente->get('field_numero_porzioni')->value ?? 0;
                
                if ($alimento_ref) {
                  $alimento = $alimento_ref->entity;
                  if ($alimento) {
                    $alimento_nome = $alimento->label();
                    $componenti_html .= '<li>' . htmlspecialchars($alimento_nome, ENT_QUOTES, 'UTF-8') . ' - ' . $numero_porzioni . ' porzioni</li>';
                  }
                }
              }
            }
          }
        }
        $componenti_html .= '</ul></div>';
      }
      
      $field_attr = $field_name ? ' data-pasto-field="' . htmlspecialchars($field_name, ENT_QUOTES, 'UTF-8') . '"' : '';
      $details = '<div id="pasto-details-' . $nid . '" class="pasto-item-custom pasto-details" data-pasto-nid="' . $nid . '"' . $field_attr . '>'
        . '<h3 class="pasto-title">' . $safe_title . '</h3>'
        . '<div class="pasto-valori-nutrizionali">'
        . '<p><strong>Calorie:</strong> ' . $kcal . ' kcal</p>'
        . '<p><strong>Carboidrati:</strong> ' . $carboidrati . 'g (' . $perc_carb . '% / ' . $target_carb . '%)</p>'
        . '<p><strong>Grassi:</strong> ' . $grassi . 'g (' . $perc_grassi . '% / ' . $target_grassi . '%)</p>'
        . '<p><strong>Proteine:</strong> ' . $proteine . 'g (' . $perc_prot . '% / ' . $target_proteine . '%)</p>'
        . '</div>'
        . $componenti_html
        . '</div>';
      $widget['#pasto_details'][$value] = \Drupal\Core\Render\Markup::create($details);
    }
    return;
  }
}