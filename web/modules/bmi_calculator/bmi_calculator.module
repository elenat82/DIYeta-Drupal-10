<?php

use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityInterface;
use Drupal\user\Entity\User;

/**
 * Implements hook_preprocess_HOOK() for user templates.
 */
//alla fine non usato perchè nel twig file non si poteva usare la variabile
function bmi_calculator_preprocess_user(&$variables) {

  $account = NULL;

  if (isset($variables['user']) && is_object($variables['user'])) {
    //equivalente:
    //$account = $variables['elements']['#user'];

    $account = $variables['user'];

    \Drupal::logger('bmi_calculator')->notice(
      'Campi utente: <pre>@dump</pre>',
      ['@dump' => print_r($account->toArray(), TRUE)]
    );
    
  }

  if (!$account) {
    return;
  }

  $uid = $account->id();

  // Recupera l'ultima misurazione corporea dell'utente
  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery();
  $nids = $query
    ->condition('type', 'misurazione_corporea')
    ->condition('uid', $uid)
    ->sort('created', 'DESC')
    ->range(0, 1)
    ->accessCheck(FALSE)
    ->execute();

  \Drupal::logger('bmi_calculator')->notice(
    'Contenuto nids: <pre>@dump</pre>',
    ['@dump' => print_r($nids, TRUE)]
  );

  if (!empty($nids)) {
    $nid = reset($nids); //Set the internal pointer of an array to its first element
    $node = Node::load($nid);
    if ($node && $node->hasField('field_peso_in_kg')) {
      $variables['ultimo_peso'] = $node->get('field_peso_in_kg')->value;

      \Drupal::logger('bmi_calculator')->notice(
        'Contenuto ultimo_peso: <pre>@dump</pre>',
        ['@dump' => print_r($variables['ultimo_peso'], TRUE)]
      );
    }
  }
}

/**
 * Implements hook_entity_insert().
 */
function bmi_calculator_entity_insert(EntityInterface $entity) {
  _bmi_calculator_update_last_weight($entity);
}

/**
 * Implements hook_entity_update().
 */
function bmi_calculator_entity_update(EntityInterface $entity) {
  _bmi_calculator_update_last_weight($entity);
}

function _bmi_calculator_update_last_weight(EntityInterface $entity) {
  // Controlla che sia un nodo del tipo giusto.
  if ($entity instanceof \Drupal\node\NodeInterface && $entity->bundle() === 'misurazione_corporea') {

    // Recupera l'utente autore del nodo.
    $uid = $entity->getOwnerId();
    $user = User::load($uid);

    if ($user && $user->hasField('field_ultimo_peso')) {
      // Recupera l'ultima misurazione corporea di questo utente.
      //anche se l'utente modifica una misurazione vecchia dobbiam sempre prendere l'ultima
      $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery();
      $nids = $query
        ->condition('type', 'misurazione_corporea')
        ->condition('uid', $uid)
        ->sort('created', 'DESC')
        ->range(0, 1)
        ->accessCheck(FALSE)
        ->execute();

      if (!empty($nids)) {
        $nid = reset($nids);
        $last_node = Node::load($nid);

        if ($last_node && $last_node->hasField('field_peso_in_kg') && !$last_node->get('field_peso_in_kg')->isEmpty()) {
          $peso = $last_node->get('field_peso_in_kg')->value;

          // Aggiorna il campo utente con l'ultimo peso.
          $user->set('field_ultimo_peso', $peso);
          $user->save();

          \Drupal::logger('bmi_calculator')->notice(
            'Aggiornato field_ultimo_peso a @peso per l\'utente @uid (ultima misurazione @nid).',
            ['@peso' => $peso, '@uid' => $uid, '@nid' => $nid]
          );
        }
      }
    }
  }
}