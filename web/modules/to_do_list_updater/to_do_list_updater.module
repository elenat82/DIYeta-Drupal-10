//}


/**
 * Implements hook_form_alter().
 */
function to_do_list_updater_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'views_form_to_do_list_bloccco_vista_todolist_1') {
    \Drupal::logger('to_do_list_updater')->notice('Alter triggered for To Do List form.');

    // Nasconde il pulsante Save.
    if (isset($form['actions'])) {
      $form['actions']['#access'] = FALSE;
    }

    // Attacca la libreria JS al form.
    $form['#attached']['library'][] = 'to_do_list_updater/to_do_list_updater';
  }
}

/**
 * Implements hook_page_attachments().
 */
function to_do_list_updater_page_attachments(array &$attachments) {
  $attachments['#attached']['drupalSettings']['csrf_token'] = \Drupal::service('csrf_token')
    ->get(Url::fromRoute('<current>')->toString());
}
