<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Render\Element;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\HtmlCommand;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\user\Entity\User;

//https://drupalize.me/tutorial/form-element-reference
//https://fossies.org/linux/drupal/core/lib/Drupal/Core/Form/FormBuilder.php
//https://pasankg.medium.com/updating-form-field-values-with-ajax-callbacks-in-drupal-10-8ecc26692185
//https://api.drupal.org/api/drupal/core%21modules%21field%21field.api.php/function/hook_field_widget_complete_form_alter/11.x

/**
 * Implements hook_form_FORM_ID_alter().
 */
function mio_pasto_form_node_pasto_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
  $form['mio_pasto_nutrition_wrapper'] = [
    '#type' => 'container',
    '#attributes' => ['id' => 'mio-pasto-nutrition-wrapper', 'class' => ['mio-pasto-nutrition-wrapper']],
    '#weight' => 100,
  ];

  // Recupera i valori dal current user.
  $current_user = \Drupal::currentUser();
  $account = User::load($current_user->id());

  // Mappa: campo pasto → campo utente
  $user_targets = [
    'field_percentuale_carboidrati' => [
      'label' => 'Carboidrati',
      'value' => $account->get('field_percentuale_carboidrati')->value ?? '',
    ],
    'field_percentuale_grassi' => [
      'label' => 'Grassi',
      'value' => $account->get('field_percentuale_grassi')->value ?? '',
    ],
    'field_percentuale_proteine' => [
      'label' => 'Proteine',
      'value' => $account->get('field_percentuale_proteine')->value ?? '',
    ],
  ];
  
  $fields_to_move = [
    'field_kcal_pasto',
    'field_proteine_pasto',
    'field_carboidrati_pasto',
    'field_grassi_pasto',
    'field_percentuale_carboidrati',
    'field_percentuale_grassi',
    'field_percentuale_proteine'
  ];

  foreach ($fields_to_move as $fname) {
    if (isset($form[$fname])) {
      $form['mio_pasto_nutrition_wrapper'][$fname] = $form[$fname];

      // Pulisci valori predefiniti.
      if (isset($form['mio_pasto_nutrition_wrapper'][$fname]['widget'][0]['value'])) {
        $form['mio_pasto_nutrition_wrapper'][$fname]['widget'][0]['value']['#default_value'] = '';
        unset($form['mio_pasto_nutrition_wrapper'][$fname]['widget'][0]['value']['#value']);
      }

      // Aggiunge il markup "Obiettivo utente" **solo per i campi percentuali**.
      $user_target = [];
      if (isset($user_targets[$fname]) && $user_targets[$fname]['value'] !== '') {
        $user_target = [
          '#type' => 'markup',
          '#markup' => '<div class="user-target"><small>Obiettivo utente (' . $user_targets[$fname]['label'] . '): <strong>' . $user_targets[$fname]['value'] . '%</strong></small></div>',
        ];
      }

      // Crea il contenitore combinato.
      $form['mio_pasto_nutrition_wrapper'][$fname] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['nutrition-field-pair']],
        'pasto_field' => $form[$fname],
        'user_target' => $user_target
      ];

      unset($form[$fname]);
    }
  }

  //intercetto pulsante remove paragraph
  if (isset($form['field_componente_pasto'])) {
    $field_componente_pasto = &$form['field_componente_pasto'];
    if (isset($field_componente_pasto['widget'])) {
      $paragraphs_widget = &$field_componente_pasto['widget'];
      foreach (Element::children($paragraphs_widget) as $delta) {
        if (isset($paragraphs_widget[$delta]['top']['actions']['dropdown_actions']['remove_button'])) {
          // @TODO da modificare, così sostituisce la funzionalità originaria del bottone remove
          $paragraphs_widget[$delta]['top']['actions']['dropdown_actions']['remove_button']['#ajax'] = [
            'callback' => 'mio_pasto_update_counter',
            'event' => 'mousedown',
            'wrapper' => 'mio-pasto-nutrition-wrapper',
            'progress' => ['type' => 'throbber'],
          ];
        }
      }
    }
  }
}


/**
 * Implements hook_field_widget_complete_form_alter().
 */
function mio_pasto_field_widget_complete_form_alter(array &$element, FormStateInterface $form_state, &$context)
{
  $field_name = $context['items']->getFieldDefinition()->getName();
  $entity_type = $context['items']->getEntity()->getEntityTypeId();
  $bundle = $context['items']->getEntity()->bundle();

  // Interveniamo solo sui paragraph che ci interessano.
  if ($entity_type === 'paragraph' && in_array($bundle, ['ingrediente_per_100_grammi', 'ingrediente_per_porzione'])) {

    // Per campi di tipo select (Entity Reference)
    if (in_array($field_name, ['field_alimento', 'field_alimento_per_porzione'])) {
      foreach (Element::children($element['widget']) as $i) {
        if (isset($element['widget'][$i]['target_id'])) {
          $element['widget'][$i]['target_id']['#ajax'] = [
            'callback' => 'mio_pasto_update_counter',
            'event' => 'change',
            'wrapper' => 'mio-pasto-nutrition-wrapper',
            'progress' => ['type' => 'throbber'],
          ];
        }
      }
    }

    // Per campi numerici
    if (in_array($field_name, ['field_quantita_in_grammi', 'field_numero_porzioni'])) {
      foreach (Element::children($element['widget']) as $i) {
        if (isset($element['widget'][$i]['value'])) {
          $element['widget'][$i]['value']['#ajax'] = [
            'callback' => 'mio_pasto_update_counter',
            'event' => 'change',
            'wrapper' => 'mio-pasto-nutrition-wrapper',
            'progress' => ['type' => 'throbber'],
          ];
        }
      }
    }
  }
}

/**
 * AJAX callback per aggiornare il contatore dei nutrienti.
 */
function mio_pasto_update_counter(array $form, FormStateInterface $form_state) {
  $uid = \Drupal::currentUser()->id();
  $user_entity = User::load($uid);

  $kcal_tot = 0;
  $protein_tot = 0;
  $carbs_tot = 0;
  $fat_tot = 0;
  $perc_protein = $perc_carbs = $perc_fat = 0;

  // Recupera i paragrafi dal field_componente_pasto
  $paragraphs = $form_state->getValue('field_componente_pasto');

  if (!empty($paragraphs)) {
    foreach ($paragraphs as $delta => $paragraph_item) {
      if (empty($paragraph_item['subform'])) {
        \Drupal::logger('mio_pasto')->notice('Delta @delta senza subform', ['@delta' => $delta]);
        continue;
      }

      $subform = $paragraph_item['subform'];

      //Alimento per 100g
      if (!empty($subform['field_alimento'][0]['target_id'])) {
        $alimento_id = $subform['field_alimento'][0]['target_id'];
        $alimento_entity = \Drupal::entityTypeManager()->getStorage('node')->load($alimento_id);

        if (!$alimento_entity) {
          \Drupal::logger('mio_pasto')->error('Nodo alimento 100g non trovato: ID @id', ['@id' => $alimento_id]);
        }
        elseif ($alimento_entity instanceof NodeInterface) {
          if (!$alimento_entity->get('field_valori_nutrizionali')->isEmpty()) {
            $paragraph = $alimento_entity->get('field_valori_nutrizionali')->entity;
            if ($paragraph) {
              $kcal = $paragraph->get('field_kcal')->value ?? 0;
              $protein = $paragraph->get('field_proteine')->value ?? 0;
              $carbs = $paragraph->get('field_carboidrati')->value ?? 0;
              $fat = $paragraph->get('field_grassi')->value ?? 0;
            }
          }

          $quantita = $subform['field_quantita_in_grammi'][0]['value'] ?? 0;

          $kcal_tot += round(($kcal * $quantita / 100));
          $protein_tot += ($protein * $quantita / 100);
          $carbs_tot += ($carbs * $quantita / 100);
          $fat_tot += ($fat * $quantita / 100);

          if ($kcal_tot > 0) {
            $perc_protein = round(($protein_tot * 4 / $kcal_tot) * 100, 1);
            $perc_carbs = round(($carbs_tot * 4 / $kcal_tot) * 100, 1);
            $perc_fat = round(($fat_tot * 9 / $kcal_tot) * 100, 1);
          }
        }
      }

      //Alimento per porzione
      if (!empty($subform['field_alimento_per_porzione'][0]['target_id'])) {
        $alimento_id = $subform['field_alimento_per_porzione'][0]['target_id'];
        $alimento_entity = \Drupal::entityTypeManager()->getStorage('node')->load($alimento_id);
        if (!$alimento_entity) {
          \Drupal::logger('mio_pasto')->error('Nodo alimento per porzione non trovato: ID @id', ['@id' => $alimento_id]);
        }
        elseif ($alimento_entity instanceof NodeInterface) {
          if (!$alimento_entity->get('field_valori_nutrizionali')->isEmpty()) {
            $paragraph = $alimento_entity->get('field_valori_nutrizionali')->entity;
            if ($paragraph) {
              $kcal = $paragraph->get('field_kcal')->value ?? 0;
              $protein = $paragraph->get('field_proteine')->value ?? 0;
              $carbs = $paragraph->get('field_carboidrati')->value ?? 0;
              $fat = $paragraph->get('field_grassi')->value ?? 0;
            }

            $n_porzioni = $subform['field_numero_porzioni'][0]['value'] ?? 0;

            $kcal_tot += round(($kcal * $n_porzioni));
            $protein_tot += ($protein * $n_porzioni);
            $carbs_tot += ($carbs * $n_porzioni);
            $fat_tot += ($fat * $n_porzioni);

            if ($kcal_tot > 0) {
              $perc_protein = round(($protein_tot * 4 / $kcal_tot) * 100, 1);
              $perc_carbs = round(($carbs_tot * 4 / $kcal_tot) * 100, 1);
              $perc_fat = round(($fat_tot * 9 / $kcal_tot) * 100, 1);
            }
          }
        }
      }
    } //Fine foreach
  }

  //Aggiornamento valori nei campi del form_state
  $form_state->setValue('field_kcal_pasto', [['value' => round($kcal_tot)]]);
  $form_state->setValue('field_proteine_pasto', [['value' => round($protein_tot, 2)]]);
  $form_state->setValue('field_carboidrati_pasto', [['value' => round($carbs_tot, 2)]]);
  $form_state->setValue('field_grassi_pasto', [['value' => round($fat_tot, 2)]]);
  $form_state->setValue('field_percentuale_proteine', [['value' => $perc_protein]]);
  $form_state->setValue('field_percentuale_carboidrati', [['value' => $perc_carbs]]);
  $form_state->setValue('field_percentuale_grassi', [['value' => $perc_fat]]);

  //Mappa campi --> valori
  $fields_map = [
    'field_kcal_pasto' => $kcal_tot,
    'field_proteine_pasto' => $protein_tot,
    'field_carboidrati_pasto' => $carbs_tot,
    'field_grassi_pasto' => $fat_tot,
    'field_percentuale_proteine' => $perc_protein,
    'field_percentuale_carboidrati' => $perc_carbs,
    'field_percentuale_grassi' => $perc_fat,
  ];

  foreach ($fields_map as $fname => $val) {
    if (isset($form['mio_pasto_nutrition_wrapper'][$fname])) {

      if (isset($form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field']['widget'][0]['value'])) {
        $form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field']['widget'][0]['value']['#value'] = (string) round($val, 2);
      }
      elseif (isset($form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field'][0]['value'])) {
        $form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field'][0]['value']['#value'] = (string) round($val, 2);
      }
      elseif (isset($form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field']['#markup'])) {
        $form['mio_pasto_nutrition_wrapper'][$fname]['pasto_field']['#markup'] = (string) round($val, 2);
      }
    }
  }

  if (isset($form['mio_pasto_nutrition_wrapper'])) {
    return $form['mio_pasto_nutrition_wrapper'];
  }

  return $form;
}


/**
 * Implements hook_node_presave().
 */
function mio_pasto_node_presave(NodeInterface $node)
{
  if ($node->bundle() !== 'pasto') {
    return;
  }

  $kcal_tot = 0.0;
  $protein_tot = 0.0;
  $carbs_tot = 0.0;
  $fat_tot = 0.0;

  $field_name = 'field_componente_pasto';

  if (!$node->hasField($field_name)) {
    \Drupal::logger('mio_pasto')->notice('Nodo pasto senza il campo %f, skip presave.', ['%f' => $field_name]);
    return;
  }

  $paragraphs = [];
  try {
    $paragraphs = $node->get($field_name)->referencedEntities();
  } catch (\Throwable $e) {
    \Drupal::logger('mio_pasto')->notice('referencedEntities() ha lanciato: @msg — useremo fallback getValue()', ['@msg' => $e->getMessage()]);
    $paragraphs = [];
  }

  // aggiungere qui controllo sulla length di $paragraphs?
  if (!empty($paragraphs) && is_array($paragraphs)) {
    foreach ($paragraphs as $paragraph) {
      if (!($paragraph instanceof \Drupal\Core\Entity\ContentEntityInterface)) {
        continue;
      }

      $bundle = $paragraph->bundle();

      if ($bundle === 'ingrediente_per_100_grammi') {
        if (!$paragraph->hasField('field_alimento') || $paragraph->get('field_alimento')->isEmpty()) {
          continue;
        }
        $alimento_ref = $paragraph->get('field_alimento')->entity;
        $qty = (float) ($paragraph->get('field_quantita_in_grammi')->value ?? 0);
        if (!$alimento_ref) {
          continue;
        }
        if ($alimento_ref->hasField('field_valori_nutrizionali') && !$alimento_ref->get('field_valori_nutrizionali')->isEmpty()) {
          $val_par = $alimento_ref->get('field_valori_nutrizionali')->entity;
          if ($val_par instanceof \Drupal\Core\Entity\ContentEntityInterface) {
            $kcal_100 = (float) ($val_par->get('field_kcal')->value ?? 0);
            $prot_100 = (float) ($val_par->get('field_proteine')->value ?? 0);
            $carb_100 = (float) ($val_par->get('field_carboidrati')->value ?? 0);
            $fat_100 = (float) ($val_par->get('field_grassi')->value ?? 0);

            $factor = $qty / 100.0;
            $kcal_tot += $kcal_100 * $factor;
            $protein_tot += $prot_100 * $factor;
            $carbs_tot += $carb_100 * $factor;
            $fat_tot += $fat_100 * $factor;
          }
        }
      } elseif ($bundle === 'ingrediente_per_porzione') {
        if (!$paragraph->hasField('field_alimento_per_porzione') || $paragraph->get('field_alimento_per_porzione')->isEmpty()) {
          continue;
        }
        $alimento_ref = $paragraph->get('field_alimento_per_porzione')->entity;
        $n_porz = (float) ($paragraph->get('field_numero_porzioni')->value ?? 0);
        if (!$alimento_ref) {
          continue;
        }
        if ($alimento_ref->hasField('field_valori_nutrizionali') && !$alimento_ref->get('field_valori_nutrizionali')->isEmpty()) {
          $val_par = $alimento_ref->get('field_valori_nutrizionali')->entity;
          if ($val_par instanceof \Drupal\Core\Entity\ContentEntityInterface) {
            $kcal_p = (float) ($val_par->get('field_kcal')->value ?? 0);
            $prot_p = (float) ($val_par->get('field_proteine')->value ?? 0);
            $carb_p = (float) ($val_par->get('field_carboidrati')->value ?? 0);
            $fat_p = (float) ($val_par->get('field_grassi')->value ?? 0);

            $kcal_tot += $kcal_p * $n_porz;
            $protein_tot += $prot_p * $n_porz;
            $carbs_tot += $carb_p * $n_porz;
            $fat_tot += $fat_p * $n_porz;
          }
        }
      }
    }
  }

  $perc_prot = $perc_carbs = $perc_fat = 0.0;
  if ($kcal_tot > 0.0) {
    $perc_prot = round(($protein_tot * 4.0 / $kcal_tot) * 100.0, 1);
    $perc_carbs = round(($carbs_tot * 4.0 / $kcal_tot) * 100.0, 1);
    $perc_fat = round(($fat_tot * 9.0 / $kcal_tot) * 100.0, 1);
  }

  if ($node->hasField('field_kcal_pasto')) {
    $node->set('field_kcal_pasto', round($kcal_tot));
  }
  if ($node->hasField('field_proteine_pasto')) {
    $node->set('field_proteine_pasto', round($protein_tot, 2));
  }
  if ($node->hasField('field_carboidrati_pasto')) {
    $node->set('field_carboidrati_pasto', round($carbs_tot, 2));
  }
  if ($node->hasField('field_grassi_pasto')) {
    $node->set('field_grassi_pasto', round($fat_tot, 2));
  }
  if ($node->hasField('field_percentuale_proteine')) {
    $node->set('field_percentuale_proteine', $perc_prot);
  }
  if ($node->hasField('field_percentuale_carboidrati')) {
    $node->set('field_percentuale_carboidrati', $perc_carbs);
  }
  if ($node->hasField('field_percentuale_grassi')) {
    $node->set('field_percentuale_grassi', $perc_fat);
  }

  \Drupal::logger('mio_pasto')->notice('node_presave: Totali Kcal=@k P=@p C=@c F=@f (prot%=@pp carb%=@cp fat%=@fp)', [
    '@k' => round($kcal_tot),
    '@p' => round($protein_tot, 2),
    '@c' => round($carbs_tot, 2),
    '@f' => round($fat_tot, 2),
    '@pp' => $perc_prot,
    '@cp' => $perc_carbs,
    '@fp' => $perc_fat,
  ]);
}

