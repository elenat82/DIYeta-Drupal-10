<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Render\Element;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\HtmlCommand;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;

//https://drupalize.me/tutorial/form-element-reference
//https://fossies.org/linux/drupal/core/lib/Drupal/Core/Form/FormBuilder.php
//https://pasankg.medium.com/updating-form-field-values-with-ajax-callbacks-in-drupal-10-8ecc26692185
//https://api.drupal.org/api/drupal/core%21modules%21field%21field.api.php/function/hook_field_widget_complete_form_alter/11.x

/**
 * Implements hook_form_FORM_ID_alter().
 */
function mio_pasto_form_node_pasto_form_alter(&$form, FormStateInterface $form_state, $form_id)
{
  // Aggiungo il box sotto al form per mostrare i nutrienti totali.
  $form['nutrition_counter'] = [
    '#type' => 'container',
    '#attributes' => ['id' => 'nutrition-counter'],
    '#weight' => 100,
    'content' => [
      '#markup' => '
        <div class="nutrition-summary">
          <ul>
            <li><strong>Kcal:</strong> 0</li>
            <li><strong>Proteine:</strong> 0g (0%)</li>
            <li><strong>Carboidrati:</strong> 0g (0%)</li>
            <li><strong>Grassi:</strong> 0g (0%)</li>
          </ul>
        </div>
      ',
    ],
  ];
}

/**
 * Implements hook_field_widget_complete_form_alter().
 */
function mio_pasto_field_widget_complete_form_alter(array &$element, FormStateInterface $form_state, &$context)
{
  $field_name = $context['items']->getFieldDefinition()->getName();
  $entity_type = $context['items']->getEntity()->getEntityTypeId();
  $bundle = $context['items']->getEntity()->bundle();

  // Interveniamo solo sui paragraph che ci interessano.
  if ($entity_type === 'paragraph' && in_array($bundle, ['ingrediente_per_100_grammi', 'ingrediente_per_porzione'])) {

    // Per campi di tipo select (Entity Reference)
    if (in_array($field_name, ['field_alimento', 'field_alimento_per_porzione'])) {
      foreach (Element::children($element['widget']) as $i) {
        if (isset($element['widget'][$i]['target_id'])) {
          $element['widget'][$i]['target_id']['#ajax'] = [
            'callback' => 'mio_pasto_update_counter',
            'event' => 'change',
            'wrapper' => 'nutrition-counter',
            'progress' => ['type' => 'throbber'],
          ];
          \Drupal::logger('mio_pasto')->notice('AJAX agganciato a @f delta @i (bundle: @b)', [
            '@f' => $field_name,
            '@i' => $i,
            '@b' => $bundle,
          ]);
        }
      }
    }

    // Per campi numerici
    if (in_array($field_name, ['field_quantita_in_grammi', 'field_numero_porzioni'])) {
      foreach (Element::children($element['widget']) as $i) {
        if (isset($element['widget'][$i]['value'])) {
          $element['widget'][$i]['value']['#ajax'] = [
            'callback' => 'mio_pasto_update_counter',
            'event' => 'change',
            'wrapper' => 'nutrition-counter',
            'progress' => ['type' => 'throbber'],
          ];
          \Drupal::logger('mio_pasto')->notice('AJAX agganciato a @f delta @i (bundle: @b)', [
            '@f' => $field_name,
            '@i' => $i,
            '@b' => $bundle,
          ]);
        }
      }
    }
  }
}


/**
 * AJAX callback per aggiornare il contatore dei nutrienti.
 */
function mio_pasto_update_counter(array $form, FormStateInterface $form_state)
{

  $kcal_tot = 0;
  $protein_tot = 0;
  $carbs_tot = 0;
  $fat_tot = 0;

  // Recupera i paragrafi dal field_componente_pasto
  $paragraphs = $form_state->getValue('field_componente_pasto');
  \Drupal::logger('mio_pasto')->notice('Paragrafi ricevuti: <pre>@dump</pre>', [
    '@dump' => print_r($paragraphs, TRUE),
  ]);

  if (!empty($paragraphs)) {
    foreach ($paragraphs as $delta => $paragraph_item) {
      if (empty($paragraph_item['subform'])) {
        \Drupal::logger('mio_pasto')->notice('Delta @delta senza subform', ['@delta' => $delta]);
        continue;
      }
      $subform = $paragraph_item['subform'];

      // Alimento per 100g
      if (!empty($subform['field_alimento'][0]['target_id'])) {
        $alimento_id = $subform['field_alimento'][0]['target_id'];
        $alimento_entity = \Drupal::entityTypeManager()->getStorage('node')->load($alimento_id);

        if (!$alimento_entity) {
          \Drupal::logger('mio_pasto')->error('Nodo alimento 100g non trovato: ID @id', ['@id' => $alimento_id]);
        } else {
          if ($alimento_entity instanceof \Drupal\node\NodeInterface) {
            $fields = $alimento_entity->getFieldDefinitions();
            $field_names = array_keys($fields);
            \Drupal::logger('mio_pasto')->notice('Campi disponibili: @fields', ['@fields' => implode(', ', $field_names)]);
            if (!$alimento_entity->get('field_valori_nutrizionali')->isEmpty()) {
              // Prendiamo il primo paragraph collegato.
              $paragraph = $alimento_entity->get('field_valori_nutrizionali')->entity;
              if ($paragraph) {
                $kcal = $paragraph->get('field_kcal')->value ?? 0;
                $protein = $paragraph->get('field_proteine')->value ?? 0;
                $carbs = $paragraph->get('field_carboidrati')->value ?? 0;
                $fat = $paragraph->get('field_grassi')->value ?? 0;
              }
            }

            $quantita = $subform['field_quantita_in_grammi'][0]['value'] ?? 0;

            $kcal_tot += ($kcal * $quantita / 100);
            $protein_tot += ($protein * $quantita / 100);
            $carbs_tot += ($carbs * $quantita / 100);
            $fat_tot += ($fat * $quantita / 100);

            // Calcolo delle percentuali
            $perc_protein = $perc_carbs = $perc_fat = 0;
            if ($kcal_tot > 0) {
              $perc_protein = round(($protein_tot * 4 / $kcal_tot) * 100, 1);
              $perc_carbs   = round(($carbs_tot * 4 / $kcal_tot) * 100, 1);
              $perc_fat     = round(($fat_tot * 9 / $kcal_tot) * 100, 1);
            }
          }
        }
      }
    }

    // Alimento per porzione
    if (!empty($subform['field_alimento_per_porzione'][0]['target_id'])) {
      $alimento_id = $subform['field_alimento_per_porzione'][0]['target_id'];
      $alimento_entity = \Drupal::entityTypeManager()->getStorage('node')->load($alimento_id);
      if (!$alimento_entity) {
        \Drupal::logger('mio_pasto')->error('Nodo alimento per porzione non trovato: ID @id', ['@id' => $alimento_id]);
      } else {
        if ($alimento_entity instanceof \Drupal\node\NodeInterface) {
          if (!$alimento_entity->get('field_valori_nutrizionali')->isEmpty()) {
            // Prendiamo il primo paragraph collegato.
            $paragraph = $alimento_entity->get('field_valori_nutrizionali')->entity;
            if ($paragraph) {
              $kcal = $paragraph->get('field_kcal')->value ?? 0;
              $protein = $paragraph->get('field_proteine')->value ?? 0;
              $carbs = $paragraph->get('field_carboidrati')->value ?? 0;
              $fat = $paragraph->get('field_grassi')->value ?? 0;
            }

            $n_porzioni = $subform['field_numero_porzioni'][0]['value'] ?? 0;

            $kcal_tot += ($kcal * $n_porzioni);
            $protein_tot += ($protein * $n_porzioni);
            $carbs_tot += ($carbs * $n_porzioni);
            $fat_tot += ($fat * $n_porzioni);

            // Calcolo delle percentuali
            $perc_protein = $perc_carbs = $perc_fat = 0;
            if ($kcal_tot > 0) {
              $perc_protein = round(($protein_tot * 4 / $kcal_tot) * 100, 1);
              $perc_carbs   = round(($carbs_tot * 4 / $kcal_tot) * 100, 1);
              $perc_fat     = round(($fat_tot * 9 / $kcal_tot) * 100, 1);
            }
          }
        }
      }
    }
  }

  // Crea la risposta AJAX
  $response = new AjaxResponse();
  $markup = "
  <div id='nutrition-counter' class='nutrition-summary'>
    <ul>
      <li><strong>Kcal:</strong> " . round($kcal_tot) . "</li>
      <li><strong>Proteine:</strong> " . round($protein_tot) . "g (" . $perc_protein . "%)</li>
      <li><strong>Carboidrati:</strong> " . round($carbs_tot) . "g (" . $perc_carbs . "%)</li>
      <li><strong>Grassi:</strong> " . round($fat_tot) . "g (" . $perc_fat . "%)</li>
    </ul>
  </div>
";

  $response->addCommand(new HtmlCommand('#nutrition-counter', $markup));

  \Drupal::logger('mio_pasto')->notice('Totali aggiornati: Kcal=@k P=@p C=@c F=@f', [
    '@k' => round($kcal_tot),
    '@p' => round($protein_tot),
    '@c' => round($carbs_tot),
    '@f' => round($fat_tot),
  ]);

  return $response;
}
