{# paragraph--valore-nutrizionale.html.twig #}

{% set unit = paragraph.field_unita_riferimento.value %}
{% set kcal = paragraph.field_kcal.value %}
{% set prot = paragraph.field_proteine.value %}
{% set grassi = paragraph.field_grassi.value %}
{% set carbo = paragraph.field_carboidrati.value %}
{% set porzione_descr = paragraph.field_porzione_descrizione.value %}

<div class="valore-nutrizionale">
  {% if unit == 'per_100g' %}
    <h4>Valori per 100 g</h4>
  {% elseif unit == 'per_porzione' %}
    <h4>Valori per porzione
    {% if porzione_descr %}
      <span class="porzione">
        ({{ porzione_descr }})
      </span>
    {% endif %}</h4>
  {% endif %}

  <ul class="macros">
    <li class="nutriente" data-label="Kcal"><i class="fa-solid fa-fire icon-fire"></i> {{ kcal }}</li>
    <li class="nutriente" data-label="Proteine"><i class="fa-solid fa-drumstick-bite icon-protein"></i> {{ prot }} g</li>
    <li class="nutriente" data-label="Grassi"><i class="fa-solid fa-bacon icon-fat"></i> {{ grassi }} g</li>
    <li class="nutriente" data-label="Carboidrati"><i class="fa-solid fa-bread-slice icon-carbs"></i> {{ carbo }} g</li>
  </ul>
</div>
