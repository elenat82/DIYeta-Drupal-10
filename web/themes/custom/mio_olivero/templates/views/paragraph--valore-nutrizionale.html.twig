{# paragraph--valore-nutrizionale.html.twig #}

{% set unit = paragraph.field_unita_riferimento.value %}
{% set kcal = paragraph.field_kcal.value %}
{% set prot = paragraph.field_proteine.value %}
{% set grassi = paragraph.field_grassi.value %}
{% set carbo = paragraph.field_carboidrati.value %}
{% set porzione_descr = paragraph.field_porzione_descrizione.value %}

<div class="valore-nutrizionale">
  {% if unit == 'per_100g' %}
    <h4>Valori per 100 g</h4>
  {% elseif unit == 'per_porzione' %}
    <h4>Valori per porzione</h4>
    {% if porzione_descr %}
      <div class="porzione">
        <small>{{ porzione_descr }}</small>
      </div>
    {% endif %}
  {% endif %}

  <ul class="macros">
    <li>Kcal: {{ kcal }}</li>
    <li>Proteine: {{ prot }} g</li>
    <li>Grassi: {{ grassi }} g</li>
    <li>Carboidrati: {{ carbo }} g</li>
  </ul>
</div>
