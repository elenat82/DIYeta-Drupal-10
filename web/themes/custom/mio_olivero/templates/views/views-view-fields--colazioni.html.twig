<div class="alimento-row">
  <div class="left">
    <h3>{{ fields.title.content }} &nbsp; &nbsp; &nbsp; &nbsp;<i class="fa-solid fa-fire icon-fire"></i>
      {{fields.field_kcal_pasto.content}}</h3>
    {{fields.field_componente_pasto.content}}
  </div>
  <div class="right">
    <div class="valori-nutrizionali">
      <div class="valore nutrizionale">
        <h4>Valori nutrizionali:</h4>
        <ul class="macros">
          <li class="nutriente" data-label="Grassi"><i class="fa-solid fa-bacon icon-fat"></i>
            {{fields.field_grassi_pasto.content}} ({{fields.field_percentuale_grassi.content}}%)</li>
          <li class="nutriente" data-label="Carboidrati"><i class="fa-solid fa-bread-slice icon-carbs"></i>
            {{fields.field_carboidrati_pasto.content}} ({{fields.field_percentuale_carboidrati.content}}%)</li>
          <li class="nutriente" data-label="Proteine"><i class="fa-solid fa-drumstick-bite icon-protein"></i>
            {{fields.field_proteine_pasto.content}} ({{fields.field_percentuale_proteine.content}}%)</li>
        </ul>
      </div>
    </div>
  </div>
</div>