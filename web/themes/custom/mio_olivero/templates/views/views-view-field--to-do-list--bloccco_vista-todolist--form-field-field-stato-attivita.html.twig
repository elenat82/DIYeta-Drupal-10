{# Checkbox custom al posto del widget di Views Entity Form Field #}
{% set is_checked = row._entity.field_stato_attivita.value ? 'checked' : '' %}
<input type="checkbox"
       class="todo-checkbox"
       data-nid="{{ row._entity.id }}"
       {{ is_checked }} />
<span class="todo-label">
  {{ row._entity.field_stato_attivita.value ? 'completata' : 'da_fare' }}
</span>
