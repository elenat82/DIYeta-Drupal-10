{% set is_checked = row._entity.field_stato_attivita.value ? 'checked' : '' %}
<label class="todo-item">
  <input type="checkbox"
         id="todo-{{ row._entity.id }}"
         class="todo-checkbox"
         data-nid="{{ row._entity.id() }}"
         {{ is_checked }} />
  <span class="todo-label">
    {{ row._entity.field_stato_attivita.value ? 'completata' : 'da fare' }}
  </span>
  <span class="todo-loader" style="display:none;"></span>
</label>
