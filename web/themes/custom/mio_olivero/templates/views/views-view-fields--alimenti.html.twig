{# https://api.drupal.org/api/drupal/core%21themes%21stable9%21templates%21views%21views-view-fields.html.twig/10 #}
<div class="alimento-row">
  <div class="left">
    <h3>{{ fields.title.content }}</h3>
    <div class="marca"><i class="fa-solid fa-tags icon-marca"></i> {{ fields.field_marca.content }}</div>
    <div class="valori-nutrizionali">{{ fields.field_valori_nutrizionali.content }}</div>
  </div>
  <div class="right">
    {{ fields.field_foto.content }}
  </div>
</div>

