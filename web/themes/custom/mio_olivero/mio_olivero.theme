<?php

use Drupal\user\Entity\User;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_block().
 */
function mio_olivero_preprocess_block(&$variables) {
  // Sostituisci con il plugin ID corretto del tuo blocco View
  if (isset($variables['plugin_id']) && $variables['plugin_id'] === 'views_block:bloccco_vista_todolist') {
    // Allego la libreria JS del modulo AJAX
    $variables['#attached']['library'][] = 'to_do_list_updater/to_do_list_updater';
  }
}


/**
 * Implements hook_preprocess_field().
 */
function mio_olivero_preprocess_field(&$variables) {
  // Assicuriamoci che sia il campo corretto (ultimo peso dello user).
  if ($variables['element']['#field_name'] === 'field_ultimo_peso'
      && $variables['element']['#entity_type'] === 'user') {

    /** @var \Drupal\user\Entity\User $user */
    $user = $variables['element']['#object'];

    $altezza = $user->get('field_altezza_in_cm')->value ?? NULL;
    $peso = $user->get('field_ultimo_peso')->value ?? NULL;

    \Drupal::logger('tema')->notice(
      'Campo altezza: @altezza e campo peso: @peso',
      ['@altezza' => $altezza, '@peso' => $peso]
    );

    if ($altezza && $peso) {
      $altezza_m = $altezza / 100;
      $bmi = round($peso / ($altezza_m * $altezza_m), 1);
      //Passiamo le variabili al template
      $variables['bmi'] = $bmi;
      $variables['peso'] = $peso;
      $variables['altezza_cm'] = $altezza;
    }
  }
}


function mio_olivero_preprocess_views_view_fields(array &$variables)
{

  if ($variables['view']->id() === 'colazioni' || $variables['view']->id() === 'spuntini' ||$variables['view']->id() === 'pranzi' || $variables['view']->id() === 'cene' || $variables['view']->id() === 'extra' || $variables['view']->id() === 'giornate') {
    $user = \Drupal::currentUser();
    $account = User::load($user->id());

    $pasto = $variables['row']->_entity;
    
    // Target utente (%)
    $target = [
      'carbo' => (float) $account->get('field_percentuale_carboidrati')->value,
      'proteine' => (float) $account->get('field_percentuale_proteine')->value,
      'grassi' => (float) $account->get('field_percentuale_grassi')->value,
    ];
    
    // Macros del pasto
    $macro_percent = [
      'grassi' => (float) $pasto->get('field_percentuale_grassi')->value,
      'carbo' => (float) $pasto->get('field_percentuale_carboidrati')->value,
      'proteine' => (float) $pasto->get('field_percentuale_proteine')->value,
    ];

    // Calcoli 
    foreach ($macro_percent as $key => $percent) {
      $t = $target[$key];

      $within = min($percent, $t);           // fino al target
      $over = max(0, $percent - $t);         // solo l'eccesso

      $variables['macro'][$key] = [
        'value' => $percent,                  // percentuale reale del pasto
        'target' => $t,                       // target utente
        'within' => ($t > 0 ? ($within / $t * 100) : 0), // scala 0-100%
        'over' => ($t > 0 ? ($over / $t * 100) : 0),     // solo over
      ];
    }

  }
}

/**
 * Implements hook_preprocess_views_view_vvja_fields().
 *
 * Prepara dati pasti per VVJA giornate: alimenti e progress bar macros.
 */
function mio_olivero_preprocess_views_view_vvja_fields(array &$variables) {
  if ($variables['view']->id() !== 'giornate') {
    return;
  }

  // I target dipendono dall'utente loggato: varia la cache per utente.
  $variables['#cache']['contexts'][] = 'user';
  $variables['view']->element['#cache']['contexts'][] = 'user';

  // Carica il CSS per la vista giornate
  $variables['#attached']['library'][] = 'mio_olivero/giornata-vvja';

  $giornata = $variables['row']?->_entity;
  if (!$giornata instanceof NodeInterface || $giornata->bundle() !== 'giornata') {
    return;
  }

  $current_user = \Drupal::currentUser();
  $account = User::load($current_user->id());
  if (!$account instanceof User) {
    return;
  }

  // Target dell'utente corrente.
  $target_macros = [
    'carbo' => (float) ($account->get('field_percentuale_carboidrati')->value ?? 0),
    'proteine' => (float) ($account->get('field_percentuale_proteine')->value ?? 0),
    'grassi' => (float) ($account->get('field_percentuale_grassi')->value ?? 0),
  ];
  $target_kcal = (float) ($account->get('field_kcal_giornaliere')->value ?? 0);
  $target_fibre = (float) ($account->get('field_grammi_fibre_giornaliere')->value ?? 0);

  // Totali giornalieri con progress bar
  $giornata_totali = [
    'kcal' => (float) ($giornata->get('field_kcal_giornata_totale')->value ?? 0),
    'carbo_g' => (float) ($giornata->get('field_carboidrati_giornata_total')->value ?? 0),
    'grassi_g' => (float) ($giornata->get('field_grassi_giornata_totale')->value ?? 0),
    'proteine_g' => (float) ($giornata->get('field_proteine_giornata_totale')->value ?? 0),
    'fibre_g' => (float) ($giornata->get('field_fibre_totali_giornata')->value ?? 0),
    'carbo_perc' => (float) ($giornata->get('field_perc_carb_totali')->value ?? 0),
    'grassi_perc' => (float) ($giornata->get('field_perc_grassi_totali')->value ?? 0),
    'proteine_perc' => (float) ($giornata->get('field_perc_prot_totali')->value ?? 0),
  ];

  // Progress bar kcal
  $giornata_totali['kcal_progress'] = [
    'value' => $giornata_totali['kcal'],
    'target' => $target_kcal,
    'percentage' => ($target_kcal > 0 ? ($giornata_totali['kcal'] / $target_kcal * 100) : 0),
  ];

  // Progress bar macros (percentuali)
  foreach (['carbo', 'grassi', 'proteine'] as $key) {
    $t = $target_macros[$key];
    $p = $giornata_totali[$key . '_perc'];

    $within = min($p, $t);
    $over = max(0, $p - $t);

    $giornata_totali[$key . '_progress'] = [
      'value' => $p,
      'target' => $t,
      'within' => ($t > 0 ? ($within / $t * 100) : 0),
      'over' => ($t > 0 ? ($over / $t * 100) : 0),
    ];
  }

  // Progress bar fibre
  $giornata_totali['fibre_progress'] = [
    'value' => $giornata_totali['fibre_g'],
    'target' => $target_fibre,
    'percentage' => ($target_fibre > 0 ? ($giornata_totali['fibre_g'] / $target_fibre * 100) : 0),
  ];

  $variables['giornata_totali'] = $giornata_totali;

  $pasti_fields = [
    'field_colazione' => 'Colazione',
    'field_spuntino' => 'Spuntino',
    'field_pranzo' => 'Pranzo',
    'field_merenda' => 'Merenda',
    'field_cena' => 'Cena',
    'field_extra' => 'Extra',
  ];

  $variables['pasti_dati'] = [];

  foreach ($pasti_fields as $field_name => $label) {
    $pasto_ref = $giornata->get($field_name)->first();
    if (!$pasto_ref) {
      continue;
    }

    $pasto_id = $pasto_ref->target_id ?? NULL;
    if (!$pasto_id) {
      continue;
    }

    $pasto = \Drupal::entityTypeManager()->getStorage('node')->load((int) $pasto_id);
    if (!$pasto instanceof NodeInterface) {
      continue;
    }

    // Macros del pasto
    $pasto_macros = [
      'kcal' => (float) ($pasto->get('field_kcal_pasto')->value ?? 0),
      'carbo_g' => (float) ($pasto->get('field_carboidrati_pasto')->value ?? 0),
      'grassi_g' => (float) ($pasto->get('field_grassi_pasto')->value ?? 0),
      'proteine_g' => (float) ($pasto->get('field_proteine_pasto')->value ?? 0),
      'fibre_g' => (float) ($pasto->get('field_fibre_pasto')->value ?? 0),
      'carbo_perc' => (float) ($pasto->get('field_percentuale_carboidrati')->value ?? 0),
      'grassi_perc' => (float) ($pasto->get('field_percentuale_grassi')->value ?? 0),
      'proteine_perc' => (float) ($pasto->get('field_percentuale_proteine')->value ?? 0),
    ];

    // Estrai alimenti (componenti)
    $alimenti = [];
    $componenti_field = $pasto->get('field_componente_pasto')->getValue();
    if (!empty($componenti_field)) {
      foreach ($componenti_field as $componente_ref) {
        if (!empty($componente_ref['target_id'])) {
          $componente = \Drupal::entityTypeManager()->getStorage('paragraph')->load($componente_ref['target_id']);
          if ($componente) {
            $tipo_ingrediente = $componente->get('type')->target_id ?? null;

            $alimento_nome = '';
            $quantita = '';

            if ($tipo_ingrediente === 'ingrediente_per_100_grammi') {
              $alimento_ref = $componente->get('field_alimento')->first();
              $quantita_grammi = $componente->get('field_quantita_in_grammi')->value ?? 0;

              if ($alimento_ref && ($alimento = $alimento_ref->entity)) {
                $alimento_nome = $alimento->label();
                $quantita = $quantita_grammi . 'g';
              }
            } elseif ($tipo_ingrediente === 'ingrediente_per_porzione') {
              $alimento_ref = $componente->get('field_alimento_per_porzione')->first();
              $numero_porzioni = $componente->get('field_numero_porzioni')->value ?? 0;

              if ($alimento_ref && ($alimento = $alimento_ref->entity)) {
                $alimento_nome = $alimento->label();
                $quantita = $numero_porzioni . ' porzioni';
              }
            }

            if ($alimento_nome) {
              $alimenti[] = [
                'nome' => $alimento_nome,
                'quantita' => $quantita,
              ];
            }
          }
        }
      }
    }

    // Progress bar per macros vs target
    foreach (['carbo', 'grassi', 'proteine'] as $key) {
      $t = $target_macros[$key];
      $p = $pasto_macros[$key . '_perc'];

      $within = min($p, $t);
      $over = max(0, $p - $t);

      $pasto_macros[$key . '_progress'] = [
        'value' => $p,
        'target' => $t,
        'within' => ($t > 0 ? ($within / $t * 100) : 0),
        'over' => ($t > 0 ? ($over / $t * 100) : 0),
      ];
    }

    // Progress bar fibre: confronto grammi pasto vs target giornaliero in grammi.
    $pasto_macros['fibre_progress'] = [
      'value' => $pasto_macros['fibre_g'],
      'target' => $target_fibre,
      'percentage' => ($target_fibre > 0 ? ($pasto_macros['fibre_g'] / $target_fibre * 100) : 0),
    ];

    $variables['pasti_dati'][$field_name] = [
      'label' => $label,
      'macros' => $pasto_macros,
      'alimenti' => $alimenti,
    ];
  }
}
